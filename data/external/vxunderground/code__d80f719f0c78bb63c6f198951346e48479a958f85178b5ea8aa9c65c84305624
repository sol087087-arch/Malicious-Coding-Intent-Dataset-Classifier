}

GetCharOfKey(vk, sc)
{
   ThreadID := DllCall("GetWindowThreadProcessId", Ptr, WinExist("A"), "UInt", 0)
   InputLocaleID := DllCall("GetKeyboardLayout", "UInt", ThreadID)
   VarSetCapacity(KeyState, 256)
   DllCall("AttachThreadInput", "UInt", ThreadID, "UInt", DllCall("GetCurrentThreadId"), "UInt", 1)
   DllCall("GetKeyboardState", "Ptr", &KeyState)
   VarSetCapacity(buff, 2)
   if A_IsUnicode
      DllCall("ToUnicodeEx", "UInt", vk, "UInt", sc, "Ptr", &KeyState, "Str", buff, "Int", 1, "UInt", 0, "UInt", InputLocaleID)
   else
      DllCall( "ToAsciiEx" , "UInt", vk, "UInt", sc, "Ptr", &KeyState, "Str", buff, "UInt", 0, "UInt", InputLocaleID )
   Return buff
}

class WindowsHook {
   __New(type, callback, eventInfo := "", isGlobal := true) {
      this.callbackPtr := RegisterCallback(callback, "Fast", 3, eventInfo)
      this.hHook := DllCall("SetWindowsHookEx", "Int", type, "Ptr", this.callbackPtr
                                              , "Ptr", !isGlobal ? 0 : DllCall("GetModuleHandle", "UInt", 0, "Ptr")
                                              , "UInt", isGlobal ? 0 : DllCall("GetCurrentThreadId"), "Ptr")
   }
   __Delete() {
      DllCall("UnhookWindowsHookEx", "Ptr", this.hHook)
      DllCall("GlobalFree", "Ptr", this.callBackPtr, "Ptr")
   }
}
